# name: test_generate_scenario_executor_snapshot
  '''
  from pathlib import Path
  
  from disciplines.Drag_scaffold import Drag
  from disciplines.Link_scaffold import Link
  from disciplines.Mass_scaffold import Mass
  from disciplines.Power_scaffold import Power
  from gemseo.formulations.mdf_settings import MDF_Settings
  from gemseo.settings.opt import NLOPT_COBYLA_Settings, SLSQP_Settings
  from generated.lib.Vleo import (
      VleoDisciplines,
      construct_Vleo,
  )
  
  
  def execute_Vleo():
      vleo = construct_Vleo(
          disciplines=VleoDisciplines(
              Drag=Drag(),
              Link=Link(),
              Mass=Mass(),
              Power=Power(),
          ),
          formulation_settings_model=MDF_Settings(),  # placeholder parameters
      )
  
      vleo.execute(NLOPT_COBYLA_Settings(max_iter=3))  # placeholder parameters
      return vleo
  
  
  def main() -> None:
      scenario = execute_Vleo()
      scenario.save_optimization_history(Path(__file__).parent / "Vleo.h5")
  
  
  if __name__ == "__main__":
      main()
  
  '''
