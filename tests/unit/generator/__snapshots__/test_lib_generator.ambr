  '''
  from abc import ABC
  
  from gemseo.core.discipline import Discipline
  from gemseo.core.grammars.pydantic_grammar import PydanticGrammar
  
  from .Drag_grammar import (
      DragInputGrammar,
      DragOutputGrammar,
  )
  from .Drag_io import DISCIPLINE_NAME
  
  
  class DragBase(Discipline, ABC):
      def __init__(self):
          super().__init__(DISCIPLINE_NAME)
          self.input_grammar = PydanticGrammar(
              f"{DISCIPLINE_NAME}_input", model=DragInputGrammar
          )
          self.output_grammar = PydanticGrammar(
              f"{DISCIPLINE_NAME}_output", model=DragOutputGrammar
          )
  
  '''
