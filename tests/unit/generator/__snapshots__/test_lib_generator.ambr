# ---
# name: test_generate_discipline_grammars[Drag]
  '''
  import numpy as np
  from gemseo.utils.pydantic_ndarray import NDArrayPydantic
  from pydantic import BaseModel, Field
  
  
  class DragInputGrammar(BaseModel):
      a_bus: NDArrayPydantic = Field(
          description="Bus frontal area [m2]", default_factory=lambda: np.array([0.1])
      )
  
      a_panel: NDArrayPydantic = Field(
          description="Solar array area [m2]", default_factory=lambda: np.array([1.0])
      )
  
      cd: NDArrayPydantic = Field(
          description="Satellite drag coefficient [-]",
          default_factory=lambda: np.array([2.2]),
      )
  
      f_thruster: NDArrayPydantic = Field(
          description="Max thruster thrust (5 mN electric propulsion) [N]",
          default_factory=lambda: np.array([0.005]),
      )
  
      h: NDArrayPydantic = Field(
          description="Orbital altitude (VLEO range) [km]",
          default_factory=lambda: np.array([300.0]),
      )
  
  
  class DragOutputGrammar(BaseModel):
      duty_cycle: NDArrayPydantic = Field(
          description="Thruster duty cycle; Drag output consumed by Power [-]"
      )
  
  '''
# ---
# name: test_generate_discipline_grammars[Link]
  '''
  import numpy as np
  from gemseo.utils.pydantic_ndarray import NDArrayPydantic
  from pydantic import BaseModel, Field
  
  
  class LinkInputGrammar(BaseModel):
      d_min: NDArrayPydantic = Field(
          description="Required data volume per ground pass [Gbit]",
          default_factory=lambda: np.array([0.05]),
      )
  
      eb_n0_req: NDArrayPydantic = Field(
          description="Required Eb/N0 (QPSK with rate-1/2 coding) [dB]",
          default_factory=lambda: np.array([6.0]),
      )
  
      f_carrier: NDArrayPydantic = Field(
          description="Downlink carrier frequency (Ka-band) [GHz]",
          default_factory=lambda: np.array([26.0]),
      )
  
      g_rx: NDArrayPydantic = Field(
          description="Ground station receive antenna gain [dBi]",
          default_factory=lambda: np.array([20.0]),
      )
  
      g_tx: NDArrayPydantic = Field(
          description="Satellite transmit antenna gain [dBi]",
          default_factory=lambda: np.array([0.0]),
      )
  
      h: NDArrayPydantic = Field(
          description="Orbital altitude (VLEO range) [km]",
          default_factory=lambda: np.array([300.0]),
      )
  
      p_tx: NDArrayPydantic = Field(
          description="Transmit power [W]", default_factory=lambda: np.array([5.0])
      )
  
      t_pass: NDArrayPydantic = Field(
          description="Ground station contact time per pass [min]",
          default_factory=lambda: np.array([10.0]),
      )
  
      t_sys: NDArrayPydantic = Field(
          description="Ground station system noise temperature [K]",
          default_factory=lambda: np.array([290.0]),
      )
  
  
  class LinkOutputGrammar(BaseModel):
      link_margin: NDArrayPydantic = Field(
          description="Link closure margin; constraint variable [dB]"
      )
  
  '''
# ---
# name: test_generate_discipline_grammars[Mass]
  '''
  import numpy as np
  from gemseo.utils.pydantic_ndarray import NDArrayPydantic
  from pydantic import BaseModel, Field
  
  
  class MassInputGrammar(BaseModel):
      a_panel: NDArrayPydantic = Field(
          description="Solar array area [m2]", default_factory=lambda: np.array([1.0])
      )
  
      m_bus: NDArrayPydantic = Field(
          description="Bus dry mass (excluding solar array) [kg]",
          default_factory=lambda: np.array([50.0]),
      )
  
      specific_mass_panel: NDArrayPydantic = Field(
          description="Solar array areal mass density [kg/m2]",
          default_factory=lambda: np.array([1.5]),
      )
  
  
  class MassOutputGrammar(BaseModel):
      m_total: NDArrayPydantic = Field(
          description="Total satellite mass; objective variable [kg]"
      )
  
  '''
# ---
# name: test_generate_discipline_grammars[Power]
  '''
  import numpy as np
  from gemseo.utils.pydantic_ndarray import NDArrayPydantic
  from pydantic import BaseModel, Field
  
  
  class PowerInputGrammar(BaseModel):
      a_panel: NDArrayPydantic = Field(
          description="Solar array area [m2]", default_factory=lambda: np.array([1.0])
      )
  
      duty_cycle: NDArrayPydantic = Field(
          description="Thruster duty cycle; Drag output consumed by Power [-]"
      )
  
      eta_panel: NDArrayPydantic = Field(
          description="Solar cell efficiency [-]",
          default_factory=lambda: np.array([0.28]),
      )
  
      f_sun: NDArrayPydantic = Field(
          description="Representative sunlit fraction per orbit [-]",
          default_factory=lambda: np.array([0.6]),
      )
  
      i_solar: NDArrayPydantic = Field(
          description="Solar irradiance [W/m2]",
          default_factory=lambda: np.array([1361.0]),
      )
  
      p_payload: NDArrayPydantic = Field(
          description="Payload power draw [W]", default_factory=lambda: np.array([30.0])
      )
  
      p_thruster: NDArrayPydantic = Field(
          description="Thruster input power at full thrust [W]",
          default_factory=lambda: np.array([200.0]),
      )
  
      p_tx: NDArrayPydantic = Field(
          description="Transmit power [W]", default_factory=lambda: np.array([5.0])
      )
  
  
  class PowerOutputGrammar(BaseModel):
      power_margin: NDArrayPydantic = Field(
          description="Power balance margin (generated minus consumed); constraint variable [W]"
      )
  
  '''
