# ---
# name: test_generate_scenario
  '''
  from dataclasses import dataclass
  from pathlib import Path
  from typing import Any
  
  from gemseo import create_scenario
  from gemseo.algos.design_space import DesignSpace
  from gemseo.core.discipline import Discipline
  from gemseo.formulations.base_formulation_settings import BaseFormulationSettings
  from gemseo.scenarios.base_scenario import BaseScenario
  
  from .variables import Var
  
  DESIGN_SPACE_DIR = Path(__file__).parent
  DESIGN_SPACE_PATH = DESIGN_SPACE_DIR / "design_space.csv"
  
  
  @dataclass
  class VleoDisciplines:
      Drag: Discipline
      Link: Discipline
      Mass: Discipline
      Power: Discipline
  
  
  def construct_Vleo(
      *,
      disciplines: VleoDisciplines,
      design_space_path: Path = DESIGN_SPACE_PATH,
      formulation_settings_model: BaseFormulationSettings | None = None,
      **formulation_settings: Any,
  ) -> BaseScenario:
      # ------------------------ from the ProblemFormulation ----------------------- #
      scenario_name = "Vleo"
      scenario_type = "MDO"
      maximize_objective = False
  
      design_variables = [
          Var.A_PANEL,
          Var.H,
          Var.P_TX,
      ]
  
      objective = Var.M_TOTAL
  
      discipline_list = [
          disciplines.Drag,
          disciplines.Link,
          disciplines.Mass,
          disciplines.Power,
      ]
      # ------------------------------------ end ----------------------------------- #
  
      # --------------------------- This part is generic --------------------------- #
      design_space = DesignSpace.from_csv(
          file_path=design_space_path,
          delimiter=",",
      ).filter(design_variables, copy=True)
  
      scenario = create_scenario(
          disciplines=discipline_list,
          objective_name=objective,
          design_space=design_space,
          name=scenario_name,
          scenario_type=scenario_type,
          maximize_objective=maximize_objective,
          formulation_settings_model=formulation_settings_model,
          **formulation_settings,
      )
      # ------------------------------------ end ----------------------------------- #
  
      # ------------------------ from the ProblemFormulation ----------------------- #
      scenario.add_constraint(
          Var.LINK_MARGIN,
          constraint_type="ineq",  # pyright: ignore[reportArgumentType]  # GEMSEO accepts string literals at runtime
          value=0.0,
          positive=True,
      )
      scenario.add_constraint(
          Var.DUTY_CYCLE,
          constraint_type="ineq",  # pyright: ignore[reportArgumentType]  # GEMSEO accepts string literals at runtime
          value=1.0,
          positive=False,
      )
      scenario.add_constraint(
          Var.POWER_MARGIN,
          constraint_type="ineq",  # pyright: ignore[reportArgumentType]  # GEMSEO accepts string literals at runtime
          value=0.0,
          positive=True,
      )
      # ------------------------------------ end ----------------------------------- #
  
      return scenario
  
  '''
# ---
# name: test_generate_variables
  '''
  from enum import StrEnum
  
  
  class Var(StrEnum):
      """All problem variables. Values are the gemseo grammar names."""
  
      H = "h"
      """Orbital altitude (VLEO range) [km]"""
  
      A_PANEL = "a_panel"
      """Solar array area [m2]"""
  
      P_TX = "p_tx"
      """Transmit power [W]"""
  
      DUTY_CYCLE = "duty_cycle"
      """Thruster duty cycle; Drag output consumed by Power [-]"""
  
      LINK_MARGIN = "link_margin"
      """Link closure margin; constraint variable [dB]"""
  
      POWER_MARGIN = "power_margin"
      """Power balance margin (generated minus consumed); constraint variable [W]"""
  
      M_TOTAL = "m_total"
      """Total satellite mass; objective variable [kg]"""
  
      D_MIN = "d_min"
      """Required data volume per ground pass [Gbit]"""
  
      M_BUS = "m_bus"
      """Bus dry mass (excluding solar array) [kg]"""
  
      SPECIFIC_MASS_PANEL = "specific_mass_panel"
      """Solar array areal mass density [kg/m2]"""
  
      F_SUN = "f_sun"
      """Representative sunlit fraction per orbit [-]"""
  
      P_PAYLOAD = "p_payload"
      """Payload power draw [W]"""
  
      ETA_PANEL = "eta_panel"
      """Solar cell efficiency [-]"""
  
      I_SOLAR = "i_solar"
      """Solar irradiance [W/m2]"""
  
      CD = "cd"
      """Satellite drag coefficient [-]"""
  
      A_BUS = "a_bus"
      """Bus frontal area [m2]"""
  
      F_THRUSTER = "f_thruster"
      """Max thruster thrust (5 mN electric propulsion) [N]"""
  
      P_THRUSTER = "p_thruster"
      """Thruster input power at full thrust [W]"""
  
      G_RX = "g_rx"
      """Ground station receive antenna gain [dBi]"""
  
      T_SYS = "t_sys"
      """Ground station system noise temperature [K]"""
  
      T_PASS = "t_pass"
      """Ground station contact time per pass [min]"""
  
      F_CARRIER = "f_carrier"
      """Downlink carrier frequency (Ka-band) [GHz]"""
  
      G_TX = "g_tx"
      """Satellite transmit antenna gain [dBi]"""
  
      EB_N0_REQ = "eb_n0_req"
      """Required Eb/N0 (QPSK with rate-1/2 coding) [dB]"""
  
  '''
# ---
