# name: test_generate_discipline_io[Drag]
  '''
  from __future__ import annotations
  
  from dataclasses import dataclass
  from pathlib import Path
  
  import numpy as np
  from numpy.typing import NDArray
  
  from .variables import Var
  
  GRAMMAR_DIR = Path(__file__).parent
  DISCIPLINE_NAME = "Drag"
  
  
  @dataclass
  class DragInputs:
      h: NDArray[np.floating]
      a_panel: NDArray[np.floating]
      cd: NDArray[np.floating]
      a_bus: NDArray[np.floating]
      f_thruster: NDArray[np.floating]
  
      @classmethod
      def from_dict(cls, d: dict[str, NDArray[np.floating]]) -> DragInputs:
          return cls(
              h=d[Var.H],
              a_panel=d[Var.A_PANEL],
              cd=d[Var.CD],
              a_bus=d[Var.A_BUS],
              f_thruster=d[Var.F_THRUSTER],
          )
  
  
  class DragOutputs(dict[str, NDArray[np.floating]]):
      def __init__(
          self,
          duty_cycle: NDArray[np.floating],
      ):
          super().__init__(
              {
                  Var.DUTY_CYCLE: duty_cycle,
              }
          )
  
  '''
